# ==========================================
# UPI Split Pay — Environment Configuration
# ==========================================

# Backend Server Configuration
PORT=8000
DEBUG=true

# Database Configuration
# Default is SQLite for local development; can be changed to PostgreSQL for production
# Example PostgreSQL: postgresql://user:password@localhost:5432/upi_split_pay
DATABASE_URL=sqlite:///./upi_split_pay.db

# Split Engine Parameters
# Maximum chunk per transaction in integer paise (Default: ₹1,999 = 199,900 paise)
DEFAULT_MAX_CHUNK_PAISE=199900
CURRENCY=INR

# Frontend Configuration
# When deploying separately from backend, specify backend URL
VITE_API_BASE_URL=http://localhost:8000/api
